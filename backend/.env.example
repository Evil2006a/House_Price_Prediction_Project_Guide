# Path to the trained model pickle (relative to the backend/ directory)
MODEL_PATH=app/models/house_price.pkl

# Path to the JSON file listing allowed locations
LOCATIONS_PATH=app/models/locations.json

# Comma-separated list is NOT supported by pydantic-settings list parsing via .env directly;
# if you need multiple origins, set this as a JSON array string, e.g.:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173"]
